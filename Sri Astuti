            const s2_1 = parseInt(document.getElementById('self-2-1').value || 0);
            const s2_2 = parseInt(document.getElementById('self-2-2').value || 0);
            const s2_3 = parseInt(document.getElementById('self-2-3').value || 0);
            const s2_4 = parseInt(document.getElementById('self-2-4').value || 0);
            const act2Score = s2_1 + s2_2 + s2_3 + s2_4;
            document.getElementById('score-act2').textContent = act2Score;
            document.getElementById('recap-2').textContent = act2Score;

            // Skor Aktivitas 3 & Kesimpulan (Maks 30: 3 tindakan x 5 poin = 15 + kesimpulan = 15)
            let act3Score = 0;
            if (document.getElementById('act3-1').value.trim().length >= 5) act3Score += 5;
            if (document.getElementById('act3-2').value.trim().length >= 5) act3Score += 5;
            if (document.getElementById('act3-3').value.trim().length >= 5) act3Score += 5;
            if (document.getElementById('act3-kesimpulan').value.trim().length >= 15) act3Score += 15;

            document.getElementById('score-act3').textContent = act3Score;
            document.getElementById('recap-3').textContent = act3Score;

            // Total Nilai Akhir
            const total = act1Score + act2Score + act3Score;
            document.getElementById('header-score').textContent = total;
            document.getElementById('total-score-display').textContent = total;

            // Penentuan Predikat (Sesuai Lampiran 2 RPM)
            const predikatEl = document.getElementById('predikat-display');
            if (total >= 86) {
                predikatEl.textContent = "Sangat Baik";
                predikatEl.className = "font-display text-lg font-bold text-emerald-400";
            } else if (total >= 71) {
                predikatEl.textContent = "Baik";
                predikatEl.className = "font-display text-lg font-bold text-teal-300";
            } else if (total >= 56) {
                predikatEl.textContent = "Cukup";
                predikatEl.className = "font-display text-lg font-bold text-amber-300";
            } else {
                predikatEl.textContent = "Perlu Bimbingan";
                predikatEl.className = "font-display text-lg font-bold text-rose-300";
            }
        }

        // Inisialisasi saat halaman dimuat
        window.addEventListener('DOMContentLoaded', () => {
            renderIcebreakers();
            selectAPKM('A');
            renderActivity1();
        });
    </script>
</body>
</html>
