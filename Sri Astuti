        function switchTab(tabName) {
            // Sembunyikan semua tab
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            // Reset tombol nav
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('bg-indigo-600', 'text-white', 'shadow-sm');
                btn.classList.add('text-slate-600', 'hover:bg-slate-100');
            });

            // Aktifkan tab terpilih
            document.getElementById('tab-' + tabName).classList.add('active');
            const activeBtn = document.getElementById('nav-' + tabName);
            activeBtn.classList.remove('text-slate-600', 'hover:bg-slate-100');
            activeBtn.classList.add('bg-indigo-600', 'text-white', 'shadow-sm');

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function toggleGoal(card) {
            const badge = card.querySelector('.goal-badge');
            const isDone = card.classList.contains('border-emerald-500');
            if (!isDone) {
                card.classList.remove('border-slate-200', 'bg-slate-50/50');
                card.classList.add('border-emerald-500', 'bg-emerald-50/40');
                badge.textContent = "✓ Dipahami";
                badge.classList.remove('bg-slate-200', 'text-slate-600');
                badge.classList.add('bg-emerald-100', 'text-emerald-800');
            } else {
                card.classList.add('border-slate-200', 'bg-slate-50/50');
                card.classList.remove('border-emerald-500', 'bg-emerald-50/40');
                badge.textContent = "Belum Dicapai";
                badge.classList.add('bg-slate-200', 'text-slate-600');
                badge.classList.remove('bg-emerald-100', 'text-emerald-800');
            }
        }

