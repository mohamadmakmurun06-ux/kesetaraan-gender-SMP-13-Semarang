        function chooseAct1(no, choice) {
            userAct1Answers[no] = choice;
            const btnSeks = document.getElementById(`btn-act1-${no}-Seks`);
            const btnGender = document.getElementById(`btn-act1-${no}-Gender`);

            btnSeks.className = "px-3.5 py-1.5 rounded-xl border border-slate-300 bg-white text-xs font-bold text-slate-700 transition";
