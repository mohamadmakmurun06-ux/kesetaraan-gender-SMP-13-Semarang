        function voteIcebreaker(id, choice) {
            const btnSetuju = document.getElementById(`ib-btn-setuju-${id}`);
            const btnTidak = document.getElementById(`ib-btn-tidak-${id}`);
            
            btnSetuju.className = "px-4 py-2 rounded-xl border-2 border-slate-200 bg-white text-xs sm:text-sm font-bold text-slate-700 transition";
            btnTidak.className = "px-4 py-2 rounded-xl border-2 border-slate-200 bg-white text-xs sm:text-sm font-bold text-slate-700 transition";

            if (choice === 'setuju') {
                btnSetuju.className = "px-4 py-2 rounded-xl border-2 border-indigo-600 bg-indigo-600 text-white text-xs sm:text-sm font-bold shadow-sm transition";
            } else {
                btnTidak.className = "px-4 py-2 rounded-xl border-2 border-teal-600 bg-teal-600 text-white text-xs sm:text-sm font-bold shadow-sm transition";
            }
        }

        function submitIcebreaker(id) {
            const fb = document.getElementById(`ib-feedback-${id}`);
            fb.classList.remove('hidden');
