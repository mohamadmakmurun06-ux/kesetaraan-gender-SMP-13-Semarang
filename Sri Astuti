                const btn = document.getElementById(`btn-apkm-${k}`);
                btn.className = "apkm-btn p-4 rounded-2xl border-2 border-slate-200 bg-white hover:border-slate-400 text-slate-800 text-left transition-all";
                btn.querySelector('div:first-child').className = `font-display text-2xl font-extrabold text-${apkmData[k].color}-600`;
            });

            // Aktifkan tombol yang diklik
            const activeBtn = document.getElementById(`btn-apkm-${key}`);
            activeBtn.className = `apkm-btn active p-4 rounded-2xl border-2 ${colorMap[key]} text-left transition-all shadow-md`;
            activeBtn.querySelector('div:first-child').className = "font-display text-2xl font-extrabold text-white";

            // Render konten detail
            const detailBox = document.getElementById('apkm-detail');
            detailBox.innerHTML = `
