        function checkActivity1() {
            let score = 0;
            act1Questions.forEach(q => {
                const userChoice = userAct1Answers[q.no];
                const row = document.getElementById(`act1-row-${q.no}`);
                const fb = document.getElementById(`act1-fb-${q.no}`);
                fb.classList.remove('hidden');

                if (userChoice === q.answer) {
                    score += 5; // 6 soal x 5 poin = 30
                    row.className = "p-4 rounded-2xl border-2 border-emerald-400 bg-emerald-50/40 transition-all";
                    fb.innerHTML = `<span class="font-bold text-emerald-700">✓ Benar (+5 poin):</span> <span class="text-slate-700">${q.reason}</span>`;
                } else if (!userChoice) {
                    row.className = "p-4 rounded-2xl border-2 border-amber-300 bg-amber-50/40 transition-all";
                    fb.innerHTML = `<span class="font-bold text-amber-700">⚠️ Belum dipilih.</span> <span class="text-slate-700">Jawaban tepat: <strong>${q.answer}</strong> (${q.reason})</span>`;
                } else {
                    row.className = "p-4 rounded-2xl border-2 border-rose-300 bg-rose-50/40 transition-all";
                    fb.innerHTML = `<span class="font-bold text-rose-700">✕ Kurang tepat.</span> <span class="text-slate-700">Seharusnya <strong>${q.answer}</strong> — ${q.reason}</span>`;
                }
            });

            act1Score = score;
            calculateTotalScore();
        }

        function resetActivity1() {
            userAct1Answers = {};
